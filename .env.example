# GAUSS Platform — Local development environment variables
#
# Copy this file to .env and fill in your own values.
# .env is gitignored and must never be committed to source control.
#
# This file is used by docker-compose.yml to configure local infrastructure.
# It is also read by test projects that require database access.
#
# See README.md — "Secrets and Local Configuration" for full setup instructions.

# SQL Server SA password for the local Docker container.
# Must match the value you configure in dotnet user-secrets for the Identity API
# and GAUSS_TEST_SQLSERVER_PASSWORD below.
MSSQL_SA_PASSWORD=Asd123!!!

# Integration and API test variables.
# These are read by the test infrastructure directly from this file,
# so you do not need to export them as shell environment variables for local runs.
# Environment variables always take precedence over values in this file.
GAUSS_TEST_SQLSERVER_HOST=localhost,1433
GAUSS_TEST_SQLSERVER_USER=sa
GAUSS_TEST_SQLSERVER_PASSWORD=Asd123!!!
GAUSS_TEST_REDIS_CONNECTION_STRING=localhost:6379,abortConnect=false
